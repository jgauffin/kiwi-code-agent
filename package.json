{
  "name": "kiwi-agent",
  "displayName": "KiwiAgent",
  "description": "Coding sessions in VS Code with a choice of model engine per session.",
  "version": "0.0.1",
  "publisher": "coderr",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.104.0",
    "node": ">=22.0.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kiwiAgent",
          "title": "KiwiAgent",
          "icon": "$(hubot)"
        }
      ]
    },
    "views": {
      "kiwiAgent": [
        {
          "id": "kiwiAgent.sessions",
          "name": "Sessions"
        },
        {
          "type": "webview",
          "id": "kiwiAgent.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "kiwiAgent.newSession",
        "title": "New Session",
        "icon": "$(add)"
      },
      {
        "command": "kiwiAgent.removeSession",
        "title": "Remove Session",
        "icon": "$(trash)"
      },
      {
        "command": "kiwiAgent.openSession",
        "title": "Open Session"
      },
      {
        "command": "kiwiAgent.openChat",
        "title": "KiwiAgent: Open Chat in Editor"
      },
      {
        "command": "kiwiAgent.setApiKey",
        "title": "KiwiAgent: Set API Key for Profile"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kiwiAgent.newSession",
          "when": "view == kiwiAgent.sessions",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "kiwiAgent.removeSession",
          "when": "view == kiwiAgent.sessions",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "kiwiAgent.removeSession",
          "when": "false"
        },
        {
          "command": "kiwiAgent.openSession",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "KiwiAgent",
      "properties": {
        "kiwiAgent.activeProfile": {
          "type": "string",
          "default": "Claude",
          "description": "Name of the profile in kiwiAgent.profiles used for new sessions."
        },
        "kiwiAgent.planProfile": {
          "type": "string",
          "default": "",
          "description": "Profile used for plan sessions. Empty: same as activeProfile."
        },
        "kiwiAgent.planIgnore": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Workspace-relative globs a Plan session must not read, carved out of docs/** and the root README. Example: docs/api/**."
        },
        "kiwiAgent.nodePath": {
          "type": "string",
          "default": "",
          "description": "Node executable used to run the Claude engine. Empty: VS Code's own executable in Node mode."
        },
        "kiwiAgent.verify": {
          "type": "array",
          "description": "Commands run when the model wants to stop after editing matching files. {project} is the nearest file matching 'project' above the edited file, {projectDir} its directory. Errors are sent back to the model and the stop is blocked, up to the failure budget.",
          "default": [
            {
              "match": "**/*.cs",
              "project": "*.csproj",
              "command": "dotnet build \"{project}\" --nologo -clp:ErrorsOnly;NoSummary"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "match",
              "command"
            ],
            "properties": {
              "match": {
                "type": "string",
                "description": "Glob on the workspace-relative path of the edited file."
              },
              "project": {
                "type": "string",
                "description": "Glob for the project file to look for upwards from the edited file, e.g. *.csproj."
              },
              "command": {
                "type": "string"
              }
            }
          }
        },
        "kiwiAgent.verifyFailureBudget": {
          "type": "integer",
          "default": 3,
          "description": "Consecutive failed verifications before the model may stop anyway."
        },
        "kiwiAgent.profiles": {
          "type": "array",
          "description": "Model profiles selectable per session.",
          "default": [
            {
              "name": "Claude",
              "engine": "claude-sdk",
              "model": "claude-opus-5"
            },
            {
              "name": "Claude Sonnet",
              "engine": "claude-sdk",
              "model": "claude-sonnet-5"
            },
            {
              "name": "GLM-5.3-Flash (Berget)",
              "engine": "openai-compatible",
              "model": "zai-org/GLM-5.3-Flash",
              "baseUrl": "https://api.berget.ai/v1",
              "apiKeySecret": "berget"
            },
            {
              "name": "Kimi K3 (Berget)",
              "engine": "openai-compatible",
              "model": "moonshotai/Kimi-K3",
              "baseUrl": "https://api.berget.ai/v1",
              "apiKeySecret": "berget"
            }
          ],
          "items": {
            "type": "object",
            "required": [
              "name",
              "engine",
              "model"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "engine": {
                "type": "string",
                "enum": [
                  "claude-sdk",
                  "openai-compatible"
                ]
              },
              "model": {
                "type": "string"
              },
              "baseUrl": {
                "type": "string"
              },
              "apiKeySecret": {
                "type": "string",
                "description": "Name under which the API key is stored in VS Code secret storage."
              },
              "effort": {
                "type": "string",
                "enum": [
                  "low",
                  "medium",
                  "high",
                  "xhigh",
                  "max"
                ]
              },
              "systemPromptFile": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies",
    "link-dev": "node scripts/link-dev.mjs",
    "unlink-dev": "node scripts/link-dev.mjs --unlink"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.2.112",
    "@anthropic-ai/sdk": "^0.81.0",
    "@relax.js/core": "^1.8.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.13",
    "mermaid": "^12.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.104.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
  }
}
